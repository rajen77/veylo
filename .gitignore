# Dependencies
node_modules/

# Packaging output: installers, unpacked trees and per-version artifacts.
# Releases belong on the GitHub release page, not in the repository.
dist/

# Flatpak build state: build tree, OSTree repo and flatpak-builder caches.
# All three are regenerated by `npm run flatpak`.
flatpak/build/
flatpak/repo/
flatpak/.flatpak-builder/

# Logs
*.log